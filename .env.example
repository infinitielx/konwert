MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=konwert_jig
# Optional: if set, the jig must call the API with &key=<value>
DEVICE_KEY=

# Dashboard login (required). Quote the password if it contains a # character.
AUTH_USERNAME=your-username
AUTH_PASSWORD="your-password"
# Random string, 16+ characters. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AUTH_SECRET=
